# 环境变量样例：复制为 .env 后填写真实值，禁止提交真实密钥
# 按项目实际需要增删

# 运行时
APP_ENV=dev
LOG_LEVEL=info
DATA_DIR=data

# B 站（仅字幕接口需要；不配置则第三层评估降级为弹幕 + 评论 + 简介）
# 获取方式：浏览器登录 B 站后 F12 → Application → Cookies → bilibili.com → SESSDATA
BILI_SESSDATA=

# 采集节奏
REQUEST_TIMEOUT=20
RATE_LIMIT_RPS=1.5

# LLM（评分与卡片生成）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
